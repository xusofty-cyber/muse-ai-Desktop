{
  "author": "Gc",
  "build": {
    "appId": "ai.muse.desktop",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US",
      "zh-TW"
    ],
    "afterPack": "scripts/cleanup-locales.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload-chat-export.js",
      "preload-settings.js",
      "hotkeys.html",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "Muse"
    },
    "portable": {
      "artifactName": "Muse-Portable-${version}.${ext}"
    },
    "productName": "Muse",
    "publish": [
      {
        "owner": "xusofty-cyber",
        "provider": "github",
        "repo": "muse-ai-Desktop",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "executableName": "muse",
      "desktop": {
        "StartupWMClass": "muse"
      },
      "category": "Network;Chat;Utility",
      "maintainer": "Gc <xusofty-cyber>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ]
    }
  },
  "dependencies": {},
  "description": "Muse for Desktop (Windows, macOS, Linux): your personal AI agent in a native desktop app",
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "muse-desktop",
  "private": true,
  "productName": "Muse",
  "scripts": {
    "dist": "electron-builder --win portable nsis",
    "dist:win": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:linux:tar": "electron-builder --linux tar.gz",
    "dist:mac": "electron-builder --mac dmg zip",
    "start": "electron ."
  },
  "version": "1.5.16"
}
