{"$id":"https://github.com/xusofty-cyber/agent-harness/gate/feature_list.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Machine-readable task state. feature_list.json is the only task-state source; only pass-gate may write status/evidence.","properties":{"features":{"items":{"if":{"properties":{"status":{"const":"passing"}}},"properties":{"area":{"type":"string"},"evidence":{"properties":{"command":{"type":"string"},"exit_code":{"type":"integer"},"output_summary":{"type":"string"},"ran_at":{"type":"string"}},"type":"object"},"id":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","type":"string"},"notes":{"type":"string"},"priority":{"type":"integer"},"status":{"enum":["not_started","in_progress","blocked","passing"],"type":"string"},"title":{"minLength":1,"type":"string"},"user_visible_behavior":{"minLength":1,"type":"string"},"verification":{"minLength":1,"type":"string"}},"required":["id","priority","area","title","user_visible_behavior","status","verification","evidence","notes"],"then":{"properties":{"evidence":{"properties":{"exit_code":{"const":0}},"required":["command","exit_code","ran_at","output_summary"]}}},"type":"object"},"type":"array"},"version":{"const":1,"type":"integer"}},"required":["version","features"],"title":"agent-harness feature_list (v3 Phase 1)","type":"object"}